#!/bin/sh
# 되돌리기 비싼 사고만 차단한다. 규약: docs/handbook/git-convention.md §1·§5
#  1) main·develop 직접 커밋
#  2) .env 스테이징 (push되면 히스토리에 남아 키 재발급 외엔 복구 불가)
#
# 아래 UI 컴포넌트 파일명 교정은 예외적으로 "차단" 대신 "자동 수정"한다 —
# 대소문자/구분자 규칙은 되돌리기 비용이 0이라 사람이 판단할 이유가 없다.

branch=$(git branch --show-current)

case "$branch" in
  main|develop)
    echo "" >&2
    echo "✗ '$branch' 브랜치에서 직접 커밋할 수 없습니다." >&2
    echo "  feature/*·fix/* 브랜치를 파고 PR로 머지하세요." >&2
    echo "  규약: docs/handbook/git-convention.md §1" >&2
    echo "" >&2
    exit 1 ;;
esac

# .env.example·.env.sample·.env.template은 커밋 대상이므로 허용
leaked=$(git diff --cached --name-only \
  | grep -E '(^|/)\.env($|\.)' \
  | grep -vE '\.(example|sample|template)$')

if [ -n "$leaked" ]; then
  echo "" >&2
  echo "✗ .env 파일이 스테이징되었습니다 — 커밋 차단." >&2
  printf '%s\n' "$leaked" | sed 's/^/    /' >&2
  echo "  git restore --staged <파일> 후 다시 커밋하세요." >&2
  echo "  이미 push된 적이 있다면 키를 폐기·재발급해야 합니다." >&2
  echo "" >&2
  exit 1
fi

# src/components/ui 파일명 규칙 — 어긋나면 자동으로 고치고 재스테이징한다.
#   *.tsx = 컴포넌트  → PascalCase   (alert-dialog.tsx → AlertDialog.tsx)
#   *.ts  = 헬퍼·타입 → camelCase    (pagination-range.ts → paginationRange.ts)
# 스테이징된 파일이 없으면 아래 루프는 한 번도 돌지 않는다(= 대부분의 커밋에서 비용 0).
for old in $(git diff --cached --name-only --diff-filter=ACMR -- 'src/components/ui/*.ts' 'src/components/ui/*.tsx'); do
  dir=$(dirname "$old")
  base=$(basename "$old")
  ext="${base##*.}"
  stem="${base%.*}"

  # 하이픈·언더스코어를 없애고 이어붙인다(2번째 조각부터 첫 글자 대문자).
  joined=$(echo "$stem" | awk -F'[-_]' '{ s=$1; for (i=2;i<=NF;i++) s = s toupper(substr($i,1,1)) substr($i,2); print s }')
  head_ch=$(printf '%s' "$joined" | cut -c1)
  rest=$(printf '%s' "$joined" | cut -c2-)
  case "$ext" in
    tsx) new_stem="$(printf '%s' "$head_ch" | tr '[:lower:]' '[:upper:]')$rest" ;;
    *)   new_stem="$(printf '%s' "$head_ch" | tr '[:upper:]' '[:lower:]')$rest" ;;
  esac

  [ "$new_stem" = "$stem" ] && continue

  new="$dir/$new_stem.$ext"

  # git mv를 쓰지 않는다: macOS·Windows처럼 core.ignorecase=true인 FS에서
  # 대소문자만 다른 rename(alert.tsx→Alert.tsx)은 옛 경로가 index에 남아
  # "새 파일 추가 + 옛 파일 잔존"으로 쪼개진다. 임시 이름 경유 2단계 + 명시적
  # --force-remove(경로를 문자 그대로 지움, FS 조회 안 함)만이 확실하다.
  if [ -e "$old" ]; then
    tmp="$dir/.__casefix.$$"
    mv "$old" "$tmp" && mv "$tmp" "$new" || { echo "✗ 파일명 교정 실패: $old" >&2; exit 1; }
  fi
  git update-index --force-remove "$old"
  git add -- "$new"

  # 이 파일을 참조하던 import 경로를 전부 갱신하고, 고친 파일만 골라 스테이징.
  # ponytail: git add -A src는 무관한 작업까지 쓸어담으므로 금지. 대상 파일에
  # 이미 unstaged 변경이 있었다면 그것도 함께 올라간다 — import 경로가 깨진 채
  # 커밋되는 것보다는 낫다는 판단. 문제가 되면 그때 검사를 붙인다.
  # 확장자를 붙여 쓰는 참조(scripts/*.mts의 '../src/components/ui/foo.ts')도 함께 잡는다.
  git grep -lE "components/ui/${stem}(\.tsx?)?['\"]" -- '*.ts' '*.tsx' '*.mts' 2>/dev/null \
    | while IFS= read -r ref; do
        perl -pi -e "s{components/ui/\Q${stem}\E(\.tsx?)?(['\"])}{components/ui/${new_stem}\$1\$2}g" "$ref"
        git add -- "$ref"
      done

  echo "ℹ src/components/ui 파일명 규칙: $base → $new_stem.$ext (자동 수정, import 경로도 갱신됨)" >&2
done

# 포맷 — 파일명 교정과 같은 이유로 "차단" 대신 "자동 수정"한다.
# prettier 결과는 기계가 정하는 것이라 사람이 판단할 여지가 없고, 되돌리기 비용도 0이다.
#
# 왜 붙였나: 포맷 한 줄 때문에 CI가 빨개지고 `style: apply prettier ...` 커밋이 하나 더
# 붙는 일이 실제로 있었다. CI(`npm run format:check`)와 **같은 도구·같은 설정**을 쓴다.
#
# ⚠ 대상 파일에 unstaged 변경이 있으면 그것도 함께 올라간다 — 위 import 경로 갱신과
#   같은 판단(포맷이 깨진 채 커밋되는 것보다 낫다).
# 타입 검사(tsc)는 여기 없다: 4초가 걸리고, 편집기와 CI가 이미 잡는다.
fmt=$(git diff --cached --name-only --diff-filter=ACMR \
  | grep -E '\.(ts|tsx|js|jsx|mjs|mts|css|json|md|ya?ml)$' || true)

if [ -n "$fmt" ]; then
  # 지워진 파일은 건너뛴다(--diff-filter로 걸러지지만 rename 직후를 대비)
  exists=$(printf '%s\n' "$fmt" | while IFS= read -r f; do [ -f "$f" ] && printf '%s\n' "$f"; done)
  if [ -n "$exists" ]; then
    before=$(printf '%s\n' "$exists" | xargs npx prettier --list-different 2>/dev/null || true)
    if [ -n "$before" ]; then
      printf '%s\n' "$before" | xargs npx prettier --write >/dev/null 2>&1
      printf '%s\n' "$before" | xargs git add --
      echo "ℹ 포맷을 자동으로 고쳐 다시 스테이징했습니다:" >&2
      printf '%s\n' "$before" | sed 's/^/    /' >&2
    fi
  fi
fi

# 이슈 연결 안내(차단 아님 — 오타·포맷팅은 이슈 없이 커밋하는 게 규약 §3)
if [ -z "$(git config --get "branch.$branch.issue" 2>/dev/null)" ]; then
  echo "ℹ 이 브랜치에 이슈 번호가 없습니다. 연결하면 (#N)이 자동으로 붙습니다:" >&2
  echo "    gh issue list" >&2
  echo "    git config branch.$branch.issue <번호>" >&2
fi

exit 0
