{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  // openapi-typescript가 뱉는 스펙 전량 타입. 사람이 안 읽고 안 고치는 파일이라 제외한다.
  // 나머지 생성물(호출 함수·훅)은 우리 생성기가 만들고 우리 규칙을 지켜야 하므로 린트한다.
  "ignorePatterns": ["scripts/**", "dist/**", "src/api/schema.d.ts"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    // 디버그 로그가 프로덕션에 새는 것을 막는다. 의도한 경고·에러는 허용.
    "no-console": ["error", { "allow": ["warn", "error"] }]
  },
  // 레이어 경계를 문서가 아니라 린터가 지킨다. 근거: docs/dev/frontend-architecture.md §3
  "overrides": [
    {
      // 도메인은 서로를 모른다 — 이 규칙이 두 사람의 작업 분할을 성립시킨다.
      //
      // 패턴이 둘인 이유: glob의 `*`는 `/`를 넘지 않아 `@/features/*/*`는 딱 두 단계만
      // 잡는다. 그래서 `@/features/{남}/AuthContext`는 막히는데
      // `@/features/{남}/components/TextField`는 통과했다 — 남의 도메인 컴포넌트를
      // 가져다 쓰는, 실제로 제일 흔한 형태가 새어나갔다. `**`가 나머지 깊이를 받는다.
      //
      // 자기 feature 안은 상대경로(`./AuthContext`)로 참조한다. 이 규칙이 자기 자신도
      // 막기 때문이기도 하고, 폴더째 옮길 때 내부 import를 다시 쓰지 않아도 되기 때문이다.
      "files": ["src/features/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/features/*/*", "@/features/*/**"],
                "message": "feature 간 교차 import 금지. 공통은 components/common으로 올린다."
              }
            ]
          }
        ]
      }
    },
    {
      // 공용 UI는 도메인을 모른다. 알아야 하면 features로 내려야 한다.
      "files": ["src/components/**", "src/lib/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/features/*", "@/features/**", "@/stores/*"],
                "message": "공용 UI는 도메인·전역 상태를 모른다. 값은 props로 받는다."
              }
            ]
          }
        ]
      }
    }
  ]
}
