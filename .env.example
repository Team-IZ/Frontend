# 실제로 넣어야 하는 것은 아래 둘뿐이다. 나머지는 안 넣어도 돈다.
#
# ⚠️ 값이 번들에 들어간다 — 배포본을 받으면 계정과 비밀번호를 볼 수 있다. 운영 환경에는
#    넣지 않는다. 팀원 실명도 넣지 않는다(자리 구분이 필요하면 `슬롯 N`처럼 번호만).

# 로그인 화면의 「역할별 바로 입장」 버튼 — 역할당 하나. JSON 배열 한 줄.
# VITE_DEV_ACCOUNTS=[{"label":"슈퍼 어드민","email":"...","password":"..."}]

# 「케이스별 계정」 목록 — 한 기수 전원. 수백 개라 손으로 못 적는다:
#
#   node scripts/dev-team-accounts.mjs <명부.md>
#     → dev-team-accounts.json   로컬이 읽는다 (파일이 환경변수보다 우선)
#     → dev-team-accounts.env    이 줄을 Vercel 환경변수에 붙여 넣는다
#
# VITE_TEAM_ACCOUNTS={"groups":[...]}

# 🔴 API 주소(`VITE_API_BASE`)는 **넣지 않는다.** 넣으면 vite 프록시·vercel rewrite를
#    건너뛰어 refresh_token이 서드파티 쿠키가 되고 새로고침마다 로그아웃된다(#201).
#    프록시 대상은 vite.config.ts와 vercel.json에 있다.

# 교육생 **상태별** 계정(미응시·응시중·창 닫힘…). 백엔드가 상태를 세워 준 엑셀이 올 때만
# `node scripts/dev-accounts.mjs <엑셀경로>`로 만든다. VITE_TEAM_ACCOUNTS와 형태가 같고
# 화면에서 그룹만 합쳐진다. 지금은 안 쓴다 — 새 명부에는 상태가 없다.
# VITE_CASE_ACCOUNTS={"measuredAt":"...","groups":[...]}
