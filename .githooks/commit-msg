#!/bin/sh
# 커밋 메시지 형식 검사 — 규약: docs/handbook/git-convention.md §4
#   type: short description (#issue-number)

msg_file="$1"
subject=$(head -n1 "$msg_file")

# 머지·리버트·fixup은 git이 생성하는 형식이라 검사 제외
case "$subject" in
  Merge\ *|Revert\ *|fixup!*|squash!*) exit 0 ;;
esac

fail() {
  echo "" >&2
  echo "✗ 커밋 메시지 규약 위반: $1" >&2
  echo "  받은 제목: $subject" >&2
  echo "" >&2
  echo "  형식: type: short description (#issue-number)" >&2
  echo "  type: feat fix refactor style docs chore remove" >&2
  echo "  예시: feat: add user login API (#5)" >&2
  echo "  규약: docs/handbook/git-convention.md §4" >&2
  echo "" >&2
  exit 1
}

# AI 공동저자 trailer 금지 — 커밋 저자는 사람이다
if grep -qiE '^(co-authored-by|generated with|🤖)' "$msg_file"; then
  echo "" >&2
  echo "✗ AI 공동저자 trailer가 포함되어 있습니다." >&2
  grep -inE '^(co-authored-by|generated with|🤖)' "$msg_file" | sed 's/^/    /' >&2
  echo "  해당 줄을 지우고 다시 커밋하세요." >&2
  echo "" >&2
  exit 1
fi

echo "$subject" | grep -qE '^(feat|fix|refactor|style|docs|chore|remove): .' \
  || fail "type 접두사가 없거나 오타 (소문자 type + 콜론 + 공백)"

echo "$subject" | grep -qE '^[a-z]+: [a-z]' \
  || fail "설명은 소문자 동사원형으로 시작 (Added/added ✗ → add ✓)"

case "$subject" in
  *.) fail "제목 끝에 마침표를 붙이지 않는다" ;;
esac

# 길이는 이슈 참조 (#N)를 제외한 설명 기준 — 훅이 자동 부착하는 메타데이터라 사용자 책임 밖.
# ponytail: 영문 소문자 제목 전제라 바이트=글자. 한글 제목을 허용하게 되면 wc -m으로 교체.
desc=$(echo "$subject" | sed -E 's/ \(#[0-9]+\)$//')
len=$(printf '%s' "$desc" | wc -c | tr -d ' ')
[ "$len" -le 50 ] || fail "설명이 50자 초과 (현재 ${len}자)"

exit 0
